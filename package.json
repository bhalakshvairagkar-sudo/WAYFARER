{
  "name": "wayfarer-ai",
  "version": "1.0.0",
  "description": "WAYFARER AI — Adaptive Journey Intelligence",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node --test tests/*.test.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "adaptive-journey-intelligence",
    "accessible-travel",
    "travel-safety",
    "personalized-travel"
  ],
  "author": "Wayfarer Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
