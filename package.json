{
  "name": "wayfarer-ai",
  "version": "1.0.0",
  "description": "WAYFARER AI — Adaptive Journey Intelligence",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node --test tests/*.test.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install --include=dev"
  },
  "keywords": [
    "adaptive-journey-intelligence",
    "accessible-travel",
    "travel-safety",
    "personalized-travel"
  ],
  "author": "Wayfarer Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "zod": "^4.6.5"
  }
}
