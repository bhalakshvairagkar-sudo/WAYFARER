# WAYFARER AI Environment Configuration

# Server Port
PORT=5000

# Google Gemini API Key for Natural Language Parsing & Comparative Explanations
# Leave empty or set to test key to run in 100% offline-resilient Deterministic Fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Maps JavaScript API Key
# Enables live Google Maps rendering, Google Places Autocomplete, and Google Directions routing
# If left empty, WAYFARER runs in DEMO / OFFLINE MAP MODE with zero crashes
VITE_GOOGLE_MAPS_API_KEY=
