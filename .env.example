# ==============================================================================
# WAYFARER AI - Production-Grade Environment Configuration Template
# All secrets must be securely provided via environment variables or secret manager.
# NEVER commit actual secrets, private keys, or passwords to Git.
# ==============================================================================

# Server Network & Runtime Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (CORS Whitelist, comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Database Security (MongoDB Atlas with TLS encryption in transit)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/wayfarer?retryWrites=true&w=majority
# If omitted or offline, WAYFARER operates in SECURE IN-MEMORY FALLBACK mode.
MONGODB_URI=

# Authentication & Cryptographic Secrets
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# Location Data Protection & Retention Policies
# Number of days before historical location coordinates are purged by MongoDB TTL indexes
LOCATION_HISTORY_RETENTION_DAYS=30

# Google Gemini API Key for Natural Language Parsing & Comparative Explanations
# Backend only: NEVER exposed to the frontend or bundled into client code.
# If left empty, WAYFARER runs in 100% offline-resilient Deterministic Rule-Based Fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Maps JavaScript API Key (Optional client key)
# If provided, must be strictly restricted to your production domain/IP in Google Cloud Console.
# If left empty, WAYFARER runs in high-fidelity OpenStreetMap / Leaflet mode with zero crashes.
VITE_GOOGLE_MAPS_API_KEY=
